---
/**
 * The shell shared by both languages.
 *
 * Everything structural lives here once; only the words change, and they come
 * from the dictionary. The article below the fold is supplied by the calling
 * page, because it is prose rather than labels.
 */
import '../styles/global.css';
import Tete from './Tete.astro';
import Pied from './Pied.astro';
import type { Dictionnaire, Langue } from '../lib/i18n/types.ts';
import { DICOS, LANGUES, LANGUE_PAR_DEFAUT } from '../lib/i18n/index.ts';
import { COUCHES, cheminBlob } from '../lib/ui/blob-path.ts';
import { noeudApplication, noeudEditeur, noeudSite, urlOutil } from '../lib/jsonld.ts';

interface Props {
  dico: Dictionnaire;
}
const { dico: T } = Astro.props;

/*
 * The address comes from `astro.config.mjs`, and from one place only. It used
 * to be copied here and into the sitemap: three copies of the same string, so
 * three chances for a canonical, an `og:url` and a sitemap to end up
 * contradicting each other. An engine given contradictory signals does not
 * settle in our favour: it ignores them and chooses for itself.
 */
const site = Astro.site?.origin;
if (!site) throw new Error('Page : « site » manque dans astro.config.mjs');
const url = urlOutil(site, T);

// Reciprocal links between the two languages, plus x-default on the language
// served at the root. Reciprocal: each page announces every language, itself
// included, without which Google ignores the declaration.
const alternates = LANGUES.map((l) => ({ lang: l, href: site + DICOS[l].base }));
const jumeaux = Object.fromEntries(LANGUES.map((l) => [l, DICOS[l].base])) as Record<
  Langue,
  string
>;

/*
 * Three linked nodes, and not one more. They are described in `lib/jsonld.ts`,
 * which explains what they buy and what they do not.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [noeudApplication(site, T), noeudSite(site), noeudEditeur(site)],
};
---

<!doctype html>
<html lang={T.htmlLang}>
  <head>
    <Tete
      dico={T}
      titre={T.meta.titre}
      description={T.meta.description}
      url={url}
      alternates={alternates}
      xDefault={site + DICOS[LANGUE_PAR_DEFAUT].base}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <!-- Le lien d'évitement pointe sur l'OUTIL, pas sur l'article. Il visait
         `#contenu`, c'est-à-dire la prose sous la ligne de flottaison : celui
         qui le suivait était donc transporté au-delà du sélecteur de fichier,
         du champ de coordonnées et du bouton de téléchargement — soit tout ce
         pour quoi il est venu. L'étiquette n'a pas changé ; elle devient vraie. -->
    <a class="saut" href="#outil">{T.nav.aller}</a>

    <!-- Décor. Purement ornemental : hors flux, hors focus, hors arbre
         d'accessibilité. La première image est gravée ici, au build, par le
         même code de géométrie que la boucle du client : le HTML servi montre
         déjà la forme, si bien que rien n'apparaît au démarrage et qu'un
         visiteur qui a demandé moins de mouvement la voit sans un octet de
         JavaScript. Il vient après le lien d'évitement, qui reste premier. -->
    <div class="decor" id="decor" aria-hidden="true">
      <svg viewBox="-110 -110 220 220" preserveAspectRatio="xMidYMid meet">
        <defs>
          {
            /* `userSpaceOnUse` is not a detail: the default frame is the
               path's bounding box, which changes every frame, so the gradient
               would resolve anew continuously and breathe with the shape
               instead of being the fixed field the outline reveals. */
            COUCHES.map((c) => (
              <radialGradient
                id={`bd-${c.id}`}
                class={`bd-${c.id}`}
                gradientUnits="userSpaceOnUse"
                cx="0"
                cy="0"
                r="76"
              >
                <stop class="dedans" offset="0" />
                <stop class="milieu" offset=".55" />
                <stop class="dehors" offset="1" />
              </radialGradient>
            ))
          }
        </defs>
        {
          COUCHES.map((c) => (
            <path data-blob transform={c.transform} fill={`url(#bd-${c.id})`} d={cheminBlob(c, 0)} />
          ))
        }
      </svg>
    </div>

    <div class="app">
      <div class="wrap">
        <!-- `header` et non `div` : la marque devient le repère « bannière ».
             Ses seuls ancêtres sont des `div`, donc le rôle tient. -->
        <header class="bar">
          <a class="brand" href={T.base}>
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <path
                d="M20 2.5c10.4 0 16.8 6.6 15.4 15.7C34 27.6 26.6 33.7 20 37.5 13.4 33.7 6 27.6 4.6 18.2 3.2 9.1 9.6 2.5 20 2.5z"
                fill="#FF3385"></path>
              <circle cx="20" cy="17.4" r="5.7" fill="#17161B"></circle>
            </svg>
            Geotager
          </a>
          <!-- `hidden` dans le HTML SERVI, et c'est tout le dispositif.
               Un navigateur ne propose pas d'installer une application qui
               l'est déjà : ce bouton ne devine donc rien et n'interroge
               personne, il attend d'être découvert par l'invitation. Sans
               invitation — déjà installée, ou navigateur qui n'en émet pas — il
               n'existe simplement pas, plutôt que d'être là sans pouvoir agir.

               Aucune règle de style à écrire : `.bar` est déjà réparti aux deux
               bouts, le bouton se pose donc à droite tout seul. -->
          <button class="btn ghost xs" type="button" id="installer" hidden>
            {T.app.installer}
          </button>
        </header>

        <!-- `main` : l'outil est le contenu principal, et il n'avait jusqu'ici
             AUCUN repère. Une personne qui navigue au lecteur d'écran par la
             liste des repères ne trouvait qu'une navigation et un pied de page,
             et jamais l'outil lui-même. `tabindex="-1"` pour que le lien
             d'évitement y dépose vraiment le focus.

             Le repère s'arrête à `.stage`, et pas plus haut : englober aussi
             `#contenu` avalerait le `footer`, qui est aujourd'hui un
             « contentinfo » correct parce que ses seuls ancêtres sont des `div`.
             Un pied de page dans `main` cesse d'être un repère. -->
        <main class="stage" id="outil" tabindex="-1">
          <!-- Le titre de la page vit ICI, et non dans l'état vide. Il y était,
               et il disparaissait donc de l'arbre d'accessibilité à la seconde
               où une photo arrivait : l'outil en marche n'avait plus de titre du
               tout, et la hiérarchie des titres commençait à `h2`.

               Il est masqué visuellement, et le grand texte du héros plus bas en
               est la copie décorative, retirée de l'arbre par `aria-hidden` pour
               qu'un lecteur d'écran n'entende pas la phrase deux fois. Le
               contrôle de build en exige exactement un : c'est celui-ci. -->
          <h1 class="visually-hidden">{T.hero.titre} {T.hero.titreEm}</h1>

          <!-- Les étapes sont rendues dès l'état vide : leur hauteur est ainsi
               réservée, et l'arrivée d'une photo ne décale rien. -->
          <!-- `role="list"` : `display: flex` retire les semantiques de liste sous
               Safari/VoiceOver, et les trois etapes redeviennent trois textes. -->
          <ol class="steps" id="etapes" role="list" aria-label={T.etapes.titre}>
            <li class="step on" data-etape="1"><span class="no">1</span> {T.etapes.deposer}</li>
            <li class="step" data-etape="2"><span class="no">2</span> {T.etapes.choisir}</li>
            <li class="step" data-etape="3"><span class="no">3</span> {T.etapes.telecharger}</li>
          </ol>

          <!-- ÉTAT VIDE — la bulle est un label : sans JavaScript, elle ouvre
               quand même le sélecteur de fichier. Le contrôle principal n'est
               jamais inerte. -->
          <div class="drop" id="etat-vide">
            <label class="bubble" for="picker">
              <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <circle cx="22" cy="22" r="8.5"></circle>
                <circle cx="22" cy="22" r="2" fill="currentColor" stroke="none"></circle>
                <path d="M22 3v8M22 33v8M3 22h8M33 22h8"></path>
              </svg>
              <span><b>{T.hero.deposez}</b><small>{T.hero.ouCollez}</small></span>
              <!-- Les vidéos ont leurs quatre opérations depuis la V1.7. Elles
                   étaient déjà acceptées avant, alors qu'aucune ne leur était
                   ouverte : mieux vaut prendre le fichier et EXPLIQUER qu'on ne
                   sait pas le traiter, que le refuser sans un mot. Le principe
                   n'a pas changé — il vaut maintenant pour la vidéo dont le
                   lieu est enregistré en mouvement, qu'on sait lire et pas
                   nettoyer. La phrase existe toujours pour ça. -->
              <!-- RIEN QUE DES TYPES MIME, jamais d'extensions — n'ajoutez pas
                   `.heic,.heif,.avif` en croyant bien faire. Chrome sous Android
                   résout chaque entrée d'`accept` en type MIME, et ces
                   extensions-là ne sont pas dans le `MimeTypeMap` du système.
                   Dès qu'une entrée n'est ni `image/*` ni `video/*`, Chrome
                   n'ouvre plus le sélecteur de photos mais l'explorateur de
                   fichiers — auquel Android interdit `Android/media` depuis la
                   11, c'est-à-dire précisément là où WhatsApp range ce qu'on
                   reçoit. Le dossier `WhatsApp` s'affichait alors VIDE. `image/*`
                   couvre déjà HEIC, AVIF et TIFF partout où le système sait les
                   nommer ; on ne perd rien de ce que la page annonce. -->
              <!-- ET PAS DE `capture` — jamais. Il ne dit pas « préfère
                   l'appareil photo » : il fait ouvrir le sélecteur de CAPTURE À
                   LA PLACE du sélecteur de fichiers. Sur iPhone, la feuille
                   « Photothèque / Prendre une photo ou une vidéo / Choisir un
                   fichier » ne s'affiche plus du tout et la photothèque devient
                   INATTEIGNABLE ; sous Android, l'appareil photo part seul et la
                   galerie disparaît de même. Ouvrir une photo DÉJÀ PRISE — le
                   geste pour lequel cet outil existe — redevenait impossible au
                   doigt, et ce champ est la seule porte qui reste sur iPhone :
                   le dépôt est de bureau, le collage n'a rien à viser dans
                   l'état vide, le partage et l'ouverture système sont de
                   Chromium.

                   `multiple` tombe avec : une prise de vue ne rend qu'UN
                   fichier, sur un outil dont tout le reste nettoie des lots.

                   Et l'attribut n'achetait rien. iOS propose déjà « Prendre une
                   photo ou une vidéo » dans cette même feuille, sans qu'on le
                   demande : on l'a payé le prix de la photothèque.

                   Seule l'ABSENCE dit « pas de capture » : le comportement tient
                   à l'attribut SPÉCIFIÉ, pas à sa valeur, et `capture=""`,
                   `"false"`, `"none"` disent tous encore capture. Si un raccourci
                   « prendre une photo » est voulu un jour, ce sera un SECOND
                   champ derrière son propre bouton, jamais un attribut sur
                   celui-ci. -->
              <input id="picker" type="file" accept="image/*,video/*" multiple />
            </label>
            <p class="hero-titre" aria-hidden="true">{T.hero.titre} <em>{T.hero.titreEm}</em></p>
            <p class="sub">{T.hero.sous}</p>
            <p class="formats">{T.hero.formats}</p>
            <!-- Le sélecteur s'ouvre sans JavaScript — la bulle est un label —
                 mais rien ne lit la photo ensuite. Mieux vaut le dire que
                 laisser quelqu'un choisir un fichier et attendre. -->
            <noscript><p class="alerte attention">{T.hero.sansJs}</p></noscript>
            <!-- Les avis qui concernent l'état VIDE. `#alerte-format` vit dans
                 l'état actif : y écrire pendant qu'on revient ici afficherait le
                 message dans un conteneur qu'on vient de masquer, donc nulle
                 part. C'est ce qui arrivait au partage perdu. -->
            <p class="alerte attention" id="avis-vide" hidden></p>
          </div>

          <!-- ÉTAT ACTIF — occupe exactement la même zone. -->
          <div class="island" id="etat-actif" hidden>
            <!-- L'état actif n'avait aucun titre, et rien ne recevait le focus
                 quand il remplaçait l'état vide : le focus retombait sur
                 `body`, et il fallait retraverser la page à la tabulation pour
                 revenir à l'endroit où l'on était. Ce titre est la cible. -->
            <h2 class="visually-hidden" id="titre-actif" tabindex="-1">{T.app.titreActif(T.app.noms.photo)}</h2>
            <div class="island-hd">
              <div class="filename">
                <!-- `bdi` : un nom de fichier vient de l'utilisateur, et un nom arabe ou
                     hebreu retournerait la ponctuation de toute la ligne autour de lui. -->
                <bdi class="nm" id="nom-fichier"></bdi>
                <span class="pill" id="pill-format"></span>
                <span class="pill hot" id="pill-position" hidden></span>
              </div>
              <button class="btn ghost xs" type="button" id="changer">{T.app.changer(T.app.noms.photo)}</button>
            </div>
            <div class="panel">
              <div id="lot" hidden>
                <p class="aide" id="lot-resume"></p>
                <ul class="file-list" id="lot-liste"></ul>
              </div>

              <div id="alerte-format" class="alerte" hidden></div>

              <div>
                <label class="champ" for="coords" id="coords-label">{T.app.ouPrise(T.app.noms.photo)}</label>
                <div class="box">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#FF3385" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4.3-4.3"></path>
                  </svg>
                  <!-- Pas d'`inputmode`. Il valait `decimal`, et le pavé que
                       cela ouvre sur iPhone ne porte ni signe moins, ni degré,
                       ni lettre d'hémisphère : aucune latitude sud, aucune
                       longitude ouest n'était saisissable au doigt, et le DMS
                       n'offrait pas de détour puisque « ° ′ ″ N S E O » n'y sont
                       pas non plus. La moitié du globe pour un attribut. Le
                       coller marchait, ce qui explique que personne ne l'ait vu.
                       Absent plutôt que `text` : un attribut qui n'existe pas ne
                       peut pas redériver. -->
                  <input
                    id="coords"
                    type="text"
                    enterkeyhint="done"
                    autocomplete="off"
                    autocapitalize="off"
                    autocorrect="off"
                    spellcheck="false"
                    placeholder="43.9493, 4.8055"
                    aria-describedby="coords-aide"
                  />
                </div>
                <p class="aide" id="coords-aide">
                  {T.app.aideCoords}<b id="coords-aide-fort">{T.app.aideCoordsFort(T.app.noms.photo)}</b>
                </p>
                <!-- Une saisie que l'analyseur refuse ne disait rien du tout :
                     le bouton de téléchargement se grisait, et c'était le seul
                     indice. Ni texte, ni `aria-invalid`, ni annonce. -->
                <p class="aide erreur" id="coords-erreur" role="alert" hidden></p>
              </div>

              <!-- La carte est REPLIÉE, et c'est tout l'accord : tant que
                   personne ne l'ouvre, aucune requête ne part, et la promesse
                   vérifiable du site tient mot pour mot. Elle n'est jamais le
                   seul chemin non plus — le champ ci-dessus fait la même chose,
                   au clavier, hors ligne. -->
              <div class="carte-bloc">
                <button
                  class="btn ghost xs"
                  type="button"
                  id="carte-bascule"
                  aria-expanded="false"
                  aria-controls="carte">{T.app.ouvrirCarte}</button>
                <div id="carte" hidden>
                  <!-- Le code de la carte n'est pas préchargé, par choix : hors
                       ligne il n'est donc pas là, et l'import dynamique échoue.
                       Il faut le dire ici plutôt que de laisser un cadre vide. -->
                  <p class="alerte attention" id="carte-erreur" hidden></p>
                  <p class="aide avis" id="carte-avis">{T.app.avisCarte(T.app.noms.photo)}</p>
                  <div class="carte-cadre">
                    <div
                      class="carte-vue"
                      id="carte-vue"
                      role="application"
                      aria-label={T.app.carteLabel}
                      tabindex="0">
                    </div>
                    <div class="carte-zoom">
                      <button type="button" id="carte-plus" aria-label={T.app.zoomAvant}>+</button>
                      <button type="button" id="carte-moins" aria-label={T.app.zoomArriere}>−</button>
                    </div>
                  </div>
                  <p class="aide carte-pied">
                    <span>{T.app.carteAide}</span>
                    <span
                      >© <a href="https://www.openstreetmap.org/copyright" rel="noopener"
                        >OpenStreetMap</a
                      > {T.app.contributeurs}</span
                    >
                  </p>
                </div>
              </div>

              <div class="result" id="resultat" hidden>
                <span class="n" id="resultat-coords"></span>
                <span class="l" id="resultat-detail"></span>
              </div>

              <!-- `aria-disabled` et non `disabled` : le bouton reste atteignable
                   au clavier, donc on peut s'y poser pour entendre POURQUOI il
                   ne fait rien. La garde est dans le gestionnaire. -->
              <button
                class="btn primary"
                type="button"
                id="telecharger"
                aria-disabled="true"
                aria-describedby="telecharger-pourquoi">
                {T.app.telecharger(T.app.noms.photo)}
              </button>
              <!-- Les trois autres contrôles inactifs sont déjà expliqués : la
                   phrase de capacité dit ce que le fichier permet, et elle est
                   annoncée. Celui-ci ne l'était pas — il est gris parce qu'aucun
                   lieu n'a encore été choisi, et rien ne le disait. -->
              <p class="visually-hidden" id="telecharger-pourquoi">{T.app.telechargerPourquoi}</p>

              <!-- Le partage sortant. Masqué tant qu'aucun fichier n'a été
                   produit, et tant que le navigateur ne sait pas partager CES
                   fichiers-là. La photo nettoyée devait jusqu'ici passer par le
                   dossier de téléchargement pour aller ailleurs. -->
              <button class="btn ghost" type="button" id="partager-sortie" hidden>
                {T.app.partagerSortie(T.app.noms.photo)}
              </button>
              <div class="minor">
                <button class="btn ghost" type="button" id="effacer">{T.app.effacer}</button>
                <button class="btn ghost" type="button" id="effacer-tout">{T.app.effacerTout}</button>
              </div>

              <details class="details" id="autres" hidden>
                <summary>{T.app.autres}</summary>
                <dl id="autres-liste"></dl>
              </details>
            </div>
          </div>
        <!-- Celui-ci vise bien l'article : c'est une invitation à lire la
             suite, pas un évitement.

             Il vit DANS le repère principal, et pas après : hors de `main` il
             était le dernier morceau de page à n'appartenir à aucun repère.
             Une troisième rangée est déclarée sur la grille pour l'accueillir,
             faute de quoi elle serait implicite et mangerait la hauteur
             verrouillée de la scène. -->
        <div class="scrollcue">
          <a href="#contenu">{T.hero.defiler}</a>
        </div>
        </main>
      </div>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" id="annonce"></p>

    <!-- Bandeau de mise à jour. Il n'est JAMAIS automatique : rien n'est
         persisté ici, donc un rechargement imposé détruirait les photos
         chargées et non exportées. Le nouveau service worker attend derrière,
         et ne prend la main que si l'on clique. -->
    <div class="maj" id="maj" role="status" hidden>
      <p id="maj-texte"></p>
      <div class="maj-actions">
        <button class="btn primary xs" type="button" id="maj-recharger">{T.app.majRecharger}</button>
        <button class="btn ghost xs" type="button" id="maj-plus-tard">{T.app.majPlusTard}</button>
      </div>
    </div>

    <!-- ============ SOUS LA LIGNE DE FLOTTAISON ============ -->
    <div class="wrap" id="contenu">
      <!-- La prose et les cartes vivaient hors de tout repère : la liste des
           repères d'un lecteur d'écran menait à l'outil, à la navigation et au
           pied de page, mais pas ici. Une `section` NOMMÉE est un repère ; sans
           nom accessible, elle n'en serait pas un. On ne peut pas étendre
           `main` jusque-là : le pied de page est un frère à l'intérieur de
           `#contenu`, et l'y enfermer lui ferait perdre son propre rôle. -->
      <section aria-label={T.nav.enSavoirPlus}>
      <!-- Embarquer un agent. Le bouton copie une consigne prête à coller dans
           un assistant IA ; le texte copié vit dans `lib/ui/invite-agent.ts`,
           à côté de ce qu'il doit continuer de désigner. Rien n'est demandé au
           réseau : la page porte déjà tout ce que le clic dépose.

           Le paragraphe qui suit est la confirmation. C'est une région
           `role="status"`, présente dès le HTML servi et vide : y écrire est
           l'annonce elle-même, pour l'écran comme pour le lecteur d'écran, et
           la vider la fait disparaître. Les pictogrammes sont décoratifs, et
           retirés de l'arbre d'accessibilité : le libellé dit déjà tout. -->
      <div class="agents">
        <button class="btn ghost" type="button" id="copier-invite">
          <span>{T.agents.bouton}</span>
          <span class="agents-icones" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="2.1" stroke-linecap="round">
              <path d="M16.5 12H22M15.9 14.25l4.76 2.75M14.25 15.9l2.75 4.76M12 16.5V22M9.75 15.9 7 20.66M8.1 14.25l-4.76 2.75M7.5 12H2M8.1 9.75 3.34 7M9.75 8.1 7 3.34M12 7.5V2M14.25 8.1 17 3.34M15.9 9.75 20.66 7"></path>
            </svg>
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="2.75" y="6" width="18.5" height="12.5" rx="6.2" stroke="currentColor" stroke-width="1.8"></rect>
              <rect x="7.6" y="9.4" width="2.7" height="5.2" rx="1.35" fill="currentColor"></rect>
              <rect x="13.7" y="9.4" width="2.7" height="5.2" rx="1.35" fill="currentColor"></rect>
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
              <path d="M12 2.8 20 7.4v9.2l-8 4.6-8-4.6V7.4Z"></path>
              <path d="M4 7.4l8 4.6 8-4.6M12 21.2V12"></path>
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="8.9" y="3.9" width="6.2" height="16.2" rx="3.1"></rect>
            </svg>
          </span>
        </button>
        <p class="agents-fait" id="invite-copiee" role="status"></p>
      </div>
      <div class="pitch">
        {
          T.pitch.map((c, i) => (
            <div class={`card c${i + 1}`}>
              <h2>{c.titre}</h2>
              <p>{c.texte}</p>
            </div>
          ))
        }
      </div>

      <article class="contenu"><slot /></article>
      </section>

      <Pied dico={T} alternatives={jumeaux} />
    </div>

    <!-- L'outil d'abord, la décoration ensuite : cet ordre est le seul moyen
         de séparation qui reste, Astro réunissant de toute façon les scripts
         hissés en un seul paquet. C'est pourquoi `blob.ts` ne lève jamais et
         se retire en silence s'il ne trouve pas son calque : le test de bout en
         bout refuse la moindre erreur de console, et une décoration n'a pas à
         pouvoir emporter l'outil avec elle. -->
    <script>
      import '../lib/ui/app.ts';
      import '../lib/ui/blob.ts';
    </script>
  </body>
</html>
