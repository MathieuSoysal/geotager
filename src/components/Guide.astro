---
/**
 * The shell of a guide.
 *
 * Everything structural lives here once; only the prose comes from the calling
 * page, because it is prose rather than labels, and cutting it into keys would
 * make it unreadable to write and to review.
 *
 * No script, and that is not a token economy. Astro bundles hoisted scripts
 * together: shipping the decoration alone would drag in all of `app.ts`, the
 * code of a tool that does not exist on this page. It would look for a file
 * picker, a coordinate field and a download button, and find none. A guide is a
 * document: it is read, not used.
 *
 * No decor either, and for a measured reason rather than taste. The layer's
 * opacities are calibrated so the hero text stays legible over them, and the
 * home page article never passes over it, since the script hides it as soon as
 * the hero leaves the screen. Without a script it would stay at full opacity
 * under a thousand words of prose, the one place the contrast was never
 * measured.
 */
import '../styles/global.css';
import Tete from './Tete.astro';
import Pied from './Pied.astro';
import type { Dictionnaire } from '../lib/i18n/types.ts';
import { LANGUES } from '../lib/i18n/index.ts';
import type { IdGuide } from '../lib/guides/index.ts';
import {
  GUIDES,
  ORDRE_GUIDES,
  alternatesGuide,
  cheminGuide,
  cheminSommaire,
  sourcesGuide,
} from '../lib/guides/index.ts';
import { derniereMaj, premierAjout } from '../lib/histoire.ts';
import {
  idApplication,
  idEditeur,
  idSite,
  noeudEditeur,
  noeudFilAriane,
  noeudSite,
} from '../lib/jsonld.ts';

interface Props {
  dico: Dictionnaire;
  id: IdGuide;
}
const { dico: T, id } = Astro.props;

const site = Astro.site?.origin;
if (!site) throw new Error('Guide : « site » manque dans astro.config.mjs');

const fiche = GUIDES[T.langue].fiches[id];
const chemin = cheminGuide(T.langue, id);
const url = site + chemin;
const titre = `${fiche.titre} — Geotager`;

// Reciprocal links between the two languages, plus x-default on the language
// served at the root. Reciprocal: each page announces every language, itself
// included, without which Google ignores the declaration.
const jumeaux = alternatesGuide(id);
const alternates = LANGUES.map((l) => ({ lang: l, href: site + jumeaux[l] }));

/*
 * Dates come from the history and are never invented. When absent they are not
 * written at all: a page published "today" on every deployment is a lie the
 * file repeats on its own.
 */
const publie = premierAjout([`src/pages${chemin}index.astro`]);
const modifie = derniereMaj(sourcesGuide(T.langue, id));

/** A readable date, without the build machine's time zone getting involved. */
const enClair = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString(T.htmlLang, {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const marches = [
  { nom: T.guides.accueil, chemin: T.base },
  { nom: T.nav.guides, chemin: cheminSommaire(T.langue) },
  { nom: fiche.titre, chemin },
];

/*
 * `about` names the application by its `@id` rather than redefining it here.
 *
 * That is exactly what an `@id` is for: naming an entity described elsewhere.
 * Copying the `SoftwareApplication` node onto each of a language's six guides
 * would declare six times an application that is not on the page, which Google's
 * documentation asks you not to do, and commit us to fixing six copies. The
 * build check verifies this identifier is the one the tool page defines: an
 * `@id` matching nothing links nothing, and it breaks silently.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      headline: fiche.h1,
      description: fiche.description,
      url,
      mainEntityOfPage: url,
      inLanguage: T.htmlLang,
      ...(publie ? { datePublished: publie } : {}),
      ...(modifie ? { dateModified: modifie } : {}),
      author: { '@id': idEditeur(site) },
      publisher: { '@id': idEditeur(site) },
      isPartOf: { '@id': idSite(site) },
      about: { '@id': idApplication(site, T) },
    },
    noeudFilAriane(site, marches),
    noeudSite(site),
    noeudEditeur(site),
  ],
};

/** The other guides in the same language, in contents-page order. */
const autres = ORDRE_GUIDES.filter((g) => g !== id).map((g) => ({
  chemin: cheminGuide(T.langue, g),
  fiche: GUIDES[T.langue].fiches[g],
}));
---

<!doctype html>
<html lang={T.htmlLang}>
  <head>
    <Tete
      dico={T}
      titre={titre}
      description={fiche.description}
      url={url}
      alternates={alternates}
      xDefault={site + jumeaux.en}
      ogType="article"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a class="saut" href="#contenu">{T.nav.aller}</a>

    <div class="wrap page-doc">
      <!-- `header` et non `div` : la marque devient le repère « bannière ».
           Ses seuls ancêtres sont des `div`, donc le rôle tient. -->
      <header class="bar">
        <a class="brand" href={T.base}>
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <path
              d="M20 2.5c10.4 0 16.8 6.6 15.4 15.7C34 27.6 26.6 33.7 20 37.5 13.4 33.7 6 27.6 4.6 18.2 3.2 9.1 9.6 2.5 20 2.5z"
              fill="#FF3385"></path>
            <circle cx="20" cy="17.4" r="5.7" fill="#17161B"></circle>
          </svg>
          Geotager
        </a>
      </header>

      <!-- `tabindex="-1"` pour que le lien d'évitement y dépose vraiment le
           focus. Le pied de page reste dehors : un `footer` dans `main` cesse
           d'être un repère « contentinfo ». -->
      <main id="contenu" tabindex="-1">
        <!-- Le fil d'Ariane existe DANS la page, et pas seulement dans le
             balisage. C'est la condition posée par la documentation de Google,
             et c'est la seule honnête : décrire une navigation absente serait
             décrire une page qui n'est pas celle qu'on sert. -->
        <nav class="fil" aria-label={T.guides.filAriane}>
          <ol>
            {
              marches.map((m, i) =>
                i === marches.length - 1 ? (
                  <li aria-current="page">{m.nom}</li>
                ) : (
                  <li>
                    <a href={m.chemin}>{m.nom}</a>
                  </li>
                ),
              )
            }
          </ol>
        </nav>

        <article class="contenu guide">
          <h1>{fiche.h1}</h1>
          {
            (publie || modifie) && (
              <p class="dates">
                {publie && <time datetime={publie}>{T.guides.publie(enClair(publie))}</time>}
                {publie && modifie && modifie !== publie && ' · '}
                {modifie && modifie !== publie && (
                  <time datetime={modifie}>{T.guides.misAJour(enClair(modifie))}</time>
                )}
              </p>
            )
          }

          <slot />

          <!-- L'appel à l'outil, une fois, à la fin. Les guides le nomment
               déjà en cours de route, là où il répond à la phrase qu'on vient
               de lire ; celui-ci est pour qui a tout lu et cherche le bouton. -->
          <aside class="essayer">
            <h2>{T.guides.essayerTitre}</h2>
            <p>{T.guides.essayerTexte}</p>
            <p><a class="btn primary" href={T.base}>{T.guides.essayerBouton}</a></p>
          </aside>

          <nav class="autres-guides" aria-label={T.guides.autres}>
            <h2>{T.guides.autres}</h2>
            <ul>
              {
                autres.map((a) => (
                  <li>
                    <a href={a.chemin}>{a.fiche.h1}</a>
                    <span>{a.fiche.resume}</span>
                  </li>
                ))
              }
            </ul>
          </nav>
        </article>
      </main>

      <Pied dico={T} alternatives={jumeaux} />
    </div>
  </body>
</html>
