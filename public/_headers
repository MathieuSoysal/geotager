# Geotagor — en-têtes servis avec les assets statiques.
# Supporté nativement par Workers (workers/static-assets/headers/).
# Limites : 100 règles, 2 000 caractères par ligne.

/*
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=(), payment=(), browsing-topics=()

# Le domaine technique ne doit pas exister en double dans l'index. Les motifs
# sont scopés par hôte : ils ne touchent jamais geotagor.fr.
https://:project.workers.dev/*
  X-Robots-Tag: noindex

https://:version.:project.workers.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
