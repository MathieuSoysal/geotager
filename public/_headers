# Geotager — en-têtes servis avec les assets statiques.
# Supporté nativement par Workers (workers/static-assets/headers/).
# Limites : 100 règles, 2 000 caractères par ligne.
#
# `img-src` nomme un hôte tiers, et un seul : les tuiles de la carte de choix du
# lieu. Rien ne les demande tant que l'utilisateur n'a pas ouvert la carte. Aucun
# autre axe n'est ouvert — `connect-src` reste fermé (les tuiles sont des <img>,
# pas des `fetch`), `script-src` et `style-src` ne changent pas, et `frame-src`
# n'existe toujours pas. Voir CREDITS.md.

/*
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; worker-src 'self' blob:; style-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; connect-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=(), payment=(), browsing-topics=()

# Le domaine technique ne doit pas exister en double dans l'index. Les motifs
# sont scopés par hôte : ils ne touchent jamais geotager.app.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

https://:version.:project.workers.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Le manifeste est explicitement typé. Servi en `application/octet-stream`, il
# est refusé sans un mot : l'installation cesse d'être proposée, et rien dans la
# page ne le dit. On ne dépend pas de la table MIME de l'hébergeur pour ça.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/fr/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# Les icônes et l'image de partage n'ont pas d'empreinte dans leur nom : elles
# ne peuvent donc pas être immuables. Une semaine, et une revalidation.
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
