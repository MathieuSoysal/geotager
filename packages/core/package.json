{
  "name": "@geotager/core",
  "version": "1.0.2",
  "type": "module",
  "description": "Read, write and remove EXIF GPS geotags: photo and video location metadata for JPEG, HEIC, AVIF, PNG, WebP, TIFF and MP4. Lossless, Node and browser.",
  "license": "MIT",
  "author": "Mathieu Soysal",
  "homepage": "https://geotager.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathieuSoysal/geotager.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/MathieuSoysal/geotager/issues",
  "keywords": [
    "exif",
    "exif-writer",
    "exif-parser",
    "gps",
    "geotag",
    "geotagging",
    "geolocation",
    "metadata",
    "image-metadata",
    "strip-exif",
    "remove-exif",
    "location",
    "coordinates",
    "lossless",
    "jpeg",
    "heic",
    "avif",
    "png",
    "webp",
    "tiff",
    "mp4",
    "quicktime",
    "privacy"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./coords": {
      "types": "./dist/coords.d.ts",
      "default": "./dist/coords.js"
    },
    "./capabilities": {
      "types": "./dist/capacites.d.ts",
      "default": "./dist/capacites.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
