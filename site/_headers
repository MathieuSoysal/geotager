# Geotagor — en-têtes servis avec les assets statiques.
# Supporté nativement par Workers (workers/static-assets/headers/).
# Limites : 100 règles, 2 000 caractères par ligne.

/*
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=(), payment=(), browsing-topics=()
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; style-src 'unsafe-inline'; img-src 'self' data:; upgrade-insecure-requests

  # AMORÇAGE UNIQUEMENT — à retirer au démarrage de la V0.
  # Le plan (§7.2) interdit un X-Robots-Tag sur motif relatif, et un contrôle
  # de build devra le faire échouer. Il n'est ici que parce que rien n'est
  # publié et qu'une page d'attente indexée serait pire que pas de page.
  X-Robots-Tag: noindex
