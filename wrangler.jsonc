{
  // Geotagor — configuration Workers (assets statiques).
  //
  // Pas de champ "main" : le site est un ensemble d'assets seuls, il n'y a
  // aucun code Worker. C'est la traduction technique de la contrainte
  // « zéro serveur » du cahier des charges — rien de nous ne s'exécute chez
  // l'hébergeur, il ne fait que servir des fichiers.
  "name": "geotager",
  "compatibility_date": "2026-07-27",

  // Astro produit "./dist". La commande de build du tableau de bord doit être
  // "npm run build", qui enchaîne astro build puis les contrôles bloquants.
  "assets": {
    "directory": "./dist"
  },

  // L'hôte technique reste ACTIF, et c'est un choix, pas un oubli.
  //
  // À « false », la production n'a aucune URL publique tant qu'un domaine
  // personnalisé n'est pas rattaché : le déploiement réussit et reste
  // inatteignable. Le risque que « false » écartait — un site indexé en double
  // sur un domaine technique — est déjà traité par les règles X-Robots-Tag
  // scopées par hôte dans public/_headers, qui est la parade que Cloudflare
  // documente lui-même. À repasser à « false » le jour où geotagor.fr est
  // rattaché, si l'on préfère la ceinture aux bretelles.
  "workers_dev": true,

  // Depuis Wrangler 4.44.0, preview_urls suit workers_dev par défaut. On le
  // réactive explicitement : les URL de prévisualisation sont ce qui rend les
  // contrôles du Gate 2 exécutables avant la mise en production.
  //
  // NÉCESSAIRE MAIS PAS SUFFISANT : la génération des URL de prévisualisation
  // et leur publication en commentaire de PR dépendent aussi de deux réglages
  // de tableau de bord que ce fichier ne peut pas porter, sous
  // Settings > Build > Branch control. Configuration confirmée le 27/07/2026 :
  //   - branche de production : main
  //   - builds de branches non-production : activés
  //
  // Ces réglages avaient d'abord la branche de travail comme branche de
  // production, ce qui déployait le code non relu directement en ligne et
  // rendait toute prévisualisation impossible — une branche de production
  // n'est pas prévisualisée, elle EST la production.
  "preview_urls": true,

  // Télémétrie côté hébergeur (Workers Logs / Workers Traces).
  //
  // Le bloc "observability" est ici avec la forme que Cloudflare génère par
  // défaut : le drapeau global reste à « false », et seul le sous-bloc "logs"
  // est activé — dans ce schéma, "logs.enabled" prime sur le drapeau global
  // pour les journaux, tandis que les traces restent explicitement coupées.
  //
  // PORTÉE RÉELLE : sans champ "main", il n'y a aucun code Worker à nous, donc
  // aucun log applicatif. Ne remontent que les journaux d'invocation
  // ("invocation_logs") produits par la plateforme pour le service d'assets :
  // requête, réponse, métadonnées. C'est de la télémétrie d'hébergeur, pas du
  // traçage de visiteur — la promesse « tout se passe dans le navigateur »
  // reste intacte, les photos et leurs coordonnées ne quittent pas la machine
  // de l'utilisateur.
  //
  // "head_sampling_rate": 1 = 100 % des requêtes échantillonnées. Rétention
  // côté Cloudflare : 7 jours.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
